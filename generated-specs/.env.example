# Environment Variables for ts15-quarkus-banking
QUARKUS_PROFILE=dev
SERVER_PORT=8080

# Database and message broker (read by the runtime kernel)
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/ts15-quarkus-banking_db
GHK_BROKER=pubsub
PUBSUB_PROJECT_ID=<gcp-project-id>
# Local Pub/Sub emulator (docker compose up pubsub); unset in GCP, where the workload identity is used
PUBSUB_EMULATOR_HOST=localhost:8085

# Security & Authentication
JWT_SECRET=<YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS>
JWT_TTL_SECONDS=3600
BCRYPT_COST_FACTOR=12

# Serverless & Cloud Configuration
AWS_REGION=us-east-1
SERVERLESS_STAGE=dev
